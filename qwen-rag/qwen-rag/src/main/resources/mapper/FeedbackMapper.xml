<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyberlanting.qwen_rag.mapper.FeedbackMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into feedback(user_id, content)
        values (#{userId}, #{content})
    </insert>
    <delete id="delete">
        delete from feedback where id = #{id}
    </delete>
    <select id="getFeedbackList" resultType="com.cyberlanting.qwen_rag.pojo.vo.FeedbackVO">
        select id, user_id, content
        from feedback
        where user_id = #{userId}
        limit #{offset}, #{pageSize}
    </select>
    <select id="getTotal" resultType="java.lang.Integer">
        select count(*) from feedback where user_id = #{userId}
    </select>
    <select id="isExist" resultType="java.lang.Boolean">
        select exists(select 1 from feedback where id = #{id} and user_id = #{userId})
    </select>
</mapper>